# Copy this file to `.streamlit/secrets.toml` for local testing against Postgres,
# OR paste its contents into Streamlit Community Cloud -> App settings -> Secrets.
#
# NEVER commit an actual secrets.toml with real credentials to GitHub.
# (.gitignore in this repo already excludes it.)

# Get this connection string from Supabase (Project Settings -> Database -> Connection string -> URI)
# or Neon (Dashboard -> Connection Details). Use the "Session pooler" / pooled connection string
# if your provider offers one - it behaves better with Streamlit's connection reuse.
DATABASE_URL = "postgresql://username:password@host:5432/dbname"

# Used to sign "remember me" login cookies so you stay logged in across page
# reloads. Set this to any long random string - it just needs to stay the
# same across reboots, otherwise everyone gets logged out on every redeploy.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET = "replace-with-a-long-random-string"